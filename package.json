{
  "name": "@yoganataa/naru-agents",
  "version": "0.0.3",
  "description": "N.A.R.U. - Next-gen Autonomous Role-based Unified agents orchestration for OpenCode with deterministic guardrails and evidence-grounded workflows",
  "type": "module",
  "bin": {
    "naru": "./bin/naru.js",
    "naru-agents": "./bin/naru.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0"
  },
  "files": [
    "bin/",
    "src/",
    "agents/",
    "knowledge/",
    "install.sh"
  ],
  "scripts": {
    "test": "node bin/naru.js validate",
    "test:plugin": "bun test src/plugin/guardrail.test.ts",
    "bench:prompts": "node src/prompt-evaluator.mjs",
    "docs:preview": "node src/docs-preview.mjs",
    "build:plugin": "bun build ./src/plugin/index.ts --outfile ./dist/naru-plugin.js --target=node --format=esm",
    "build:bin": "bun build --compile --minify ./bin/naru.js --outfile ./dist/naru.exe",
    "build:all": "bun build --compile --minify ./bin/naru.js --target=bun-windows-x64 --outfile=./dist/naru-windows.exe && bun build --compile --minify ./bin/naru.js --target=bun-linux-x64 --outfile=./dist/naru-linux && bun build --compile --minify ./bin/naru.js --target=bun-darwin-arm64 --outfile=./dist/naru-macos"
  },
  "keywords": [
    "opencode",
    "ai",
    "agent",
    "naru",
    "orchestration",
    "subagent",
    "bun",
    "guardrails",
    "human-in-the-loop"
  ],
  "author": "yoganataa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoganataa/naru-agents.git"
  },
  "bugs": {
    "url": "https://github.com/Yoganataa/naru-agents/issues"
  },
  "homepage": "https://github.com/Yoganataa/naru-agents#readme",
  "devDependencies": {
    "marked": "^18.0.10"
  },
  "dependencies": {
    "@opentui/core": "^0.5.6"
  }
}
